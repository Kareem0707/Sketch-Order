# ========================================================
# Sketch Order - Environment Variables Configuration
# ========================================================

# 1. Google Cloud Console Credentials (OAuth 2.0 Web Client)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Ensure Authorized JavaScript origins include:
# - http://localhost:5173
# - https://your-production-domain.com
VITE_GOOGLE_CLIENT_ID=583524414496-pap3nvm82t5i7fl3i9od8bj60maec9gc.apps.googleusercontent.com

# 2. Vercel API Integration for Live Custom Domains
# Personal access token from: https://vercel.com/account/tokens
VITE_VERCEL_TOKEN=your-vercel-token-here

# Vercel Project ID or slug (e.g. prj_xxxx or sketch-order)
VITE_VERCEL_PROJECT_ID=sketch-order

# Optional: Vercel Team ID if deployed under a team account
# VITE_VERCEL_TEAM_ID=team_xxxx

# 3. Secret Admin Vault
# Master password for the secret admin gate (/#secret-admin)
VITE_ADMIN_MASTER_PASSWORD=sketch2026admin
